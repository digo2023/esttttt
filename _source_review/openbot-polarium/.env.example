# ============================================================
# openbot-polarium v2.0 - Environment variables
# Copy to .env and fill credentials
# ============================================================

# APInex (LLM API - free tier with 25M tokens/day after $5 top-up)
APINEX_API_KEY=apx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=gpt-4o-mini          # free model

# Polarium credentials (OPTIONAL - if empty, use browser login capture)
# Run `openbot login` to auto-capture via Playwright
POLARIUM_SSO_TOKEN=
POLARIUM_EMAIL=
POLARIUM_PASSWORD=

# Polarium endpoints (auto-detected, override only if needed)
POLARIUM_API_WSS=
POLARIUM_API_HTTPS=
POLARIUM_BROKER_ID=11

# Trading mode
TRADING_MODE=paper                 # paper | real  (override per session)
ACCOUNT_TYPE=practice              # practice | real

# Risk management
INITIAL_BALANCE=1000
ENTRY_VALUE=20                     # fixed stake in account currency
STOP_WIN=30                        # % daily profit target
STOP_LOSS=20                       # % daily loss limit
MAX_TRADES_PER_DAY=20
MAX_CONCURRENT_TRADES=1
MAX_GALE_LEVELS=2
USE_MARTINGALE=true
MARTINGALE_MULTIPLIER=2.0

# Auto-execution (DANGER ZONE)
AUTO_EXECUTE=false                 # MUST be true to auto-execute real trades
MIN_CONFIDENCE_TO_EXECUTE=0.70     # only execute signals above this

# Scanner
SCAN_ASSETS=EURUSD-OTC,GBPUSD-OTC,EURGBP-OTC,USDJPY-OTC,BTCUSD,ETHUSD
SCAN_TIMEFRAMES=M1,M5
SCAN_INTERVAL_SEC=15

# Self-healing
MAX_RETRIES=3
RETRY_BACKOFF_SEC=2
WS_RECONNECT_DELAY_SEC=5

# Learning (online weighting)
LEARNING_ENABLED=true
LEARNING_WINDOW=50                 # last N trades for weight calc
LEARNING_RATE=0.1                  # how fast weights adjust
REVALIDATE_AFTER_LOSS=true         # re-pick top indicators after each loss

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/openbot.log
SIGNALS_CSV=logs/signals.csv
TRADES_CSV=logs/trades.csv
